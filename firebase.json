{
  "hosting": {
    "public": "hosting-public",
    "cleanUrls": true,
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "plataforma/assets/marca/logo-guia-local.png",
      "plataforma/assets/marca/fondo-ciudad.jpg"
    ],
    "headers": [
      {
        "source": "/plataforma/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/recursos/marca/logo-guia-local.22471714566e.png",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/recursos/marca/fondo-ciudad.c6bd6e1cc99b.jpg",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/plataforma/granhermano",
        "destination": "/plataforma/administracion",
        "type": 301
      },
      {
        "source": "/plataforma/granhermano.html",
        "destination": "/plataforma/administracion",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/plataforma/inicio.html"
      },
      {
        "source": "/elegi-tu-ciudad",
        "destination": "/plataforma/inicio.html"
      },
      {
        "source": "/descubrir",
        "destination": "/plataforma/carcasa.html"
      },
      {
        "source": "/ecosistema",
        "destination": "/plataforma/nosotros.html"
      },
      {
        "source": "/app",
        "destination": "/plataforma/app-prueba.html"
      },
      {
        "source": "/politicas-y-privacidad",
        "destination": "/plataforma/privacidad.html"
      },
      {
        "source": "/mi-guia",
        "destination": "/plataforma/suscriptores.html"
      },
      {
        "source": "/anunciantes",
        "destination": "/plataforma/login.html"
      },
      {
        "source": "/administracion",
        "destination": "/plataforma/administracion.html"
      },
      {
        "source": "/plataforma/assets/marca/logo-guia-local.png",
        "destination": "/recursos/marca/logo-guia-local.22471714566e.png"
      },
      {
        "source": "/plataforma/assets/marca/fondo-ciudad.jpg",
        "destination": "/recursos/marca/fondo-ciudad.c6bd6e1cc99b.jpg"
      }
    ]
  }
}

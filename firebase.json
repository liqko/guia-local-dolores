{
  "hosting": {
    "public": "hosting-public",
    "cleanUrls": true,
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/descubrir",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/plataforma/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/plataforma/assets/app/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/plataforma/granhermano",
        "destination": "/plataforma/administracion",
        "type": 301
      },
      {
        "source": "/plataforma/granhermano.html",
        "destination": "/plataforma/administracion",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/plataforma/inicio.html"
      },
      {
        "source": "/elegi-tu-ciudad",
        "destination": "/plataforma/inicio.html"
      },
      {
        "source": "/descubrir",
        "destination": "/plataforma/carcasa.html"
      },
      {
        "source": "/ecosistema",
        "destination": "/plataforma/nosotros.html"
      },
      {
        "source": "/app",
        "destination": "/plataforma/app-prueba.html"
      },
      {
        "source": "/politicas-y-privacidad",
        "destination": "/plataforma/privacidad.html"
      },
      {
        "source": "/mi-guia",
        "destination": "/plataforma/suscriptores.html"
      },
      {
        "source": "/crear-cuenta",
        "destination": "/plataforma/suscriptores.html"
      },
      {
        "source": "/ingresar",
        "destination": "/plataforma/suscriptores.html"
      },
      {
        "source": "/registrar-anuncio",
        "destination": "/plataforma/login.html"
      },
      {
        "source": "/cargar-evento-free",
        "destination": "/plataforma/login.html"
      },
      {
        "source": "/reclamar-anuncio",
        "destination": "/plataforma/login.html"
      },
      {
        "source": "/anunciantes",
        "destination": "/plataforma/login.html"
      },
      {
        "source": "/administracion",
        "destination": "/plataforma/administracion.html"
      }
    ]
  }
}

{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "worker/**",
      "tests/**",
      "docs/**",
      "AGENTS.md"
    ],
    "headers": [
      {
        "source": "/plataforma/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/plataforma/granhermano",
        "destination": "/plataforma/administracion",
        "type": 301
      },
      {
        "source": "/plataforma/granhermano.html",
        "destination": "/plataforma/administracion",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/plataforma/inicio.html"
      },
      {
        "source": "/elegi-tu-ciudad",
        "destination": "/plataforma/inicio.html"
      },
      {
        "source": "/descubrir",
        "destination": "/plataforma/carcasa.html"
      },
      {
        "source": "/ecosistema",
        "destination": "/plataforma/nosotros.html"
      },
      {
        "source": "/app",
        "destination": "/plataforma/app-prueba.html"
      },
      {
        "source": "/politicas-y-privacidad",
        "destination": "/plataforma/privacidad.html"
      },
      {
        "source": "/mi-guia",
        "destination": "/plataforma/suscriptores.html"
      },
      {
        "source": "/anunciantes",
        "destination": "/plataforma/login.html"
      },
      {
        "source": "/administracion",
        "destination": "/plataforma/administracion.html"
      }
    ]
  }
}

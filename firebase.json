{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "worker/**",
      "tests/**",
      "docs/**",
      "AGENTS.md"
    ],
    "headers": [
      {
        "source": "/plataforma/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/plataforma/granhermano",
        "destination": "/plataforma/administracion",
        "type": 301
      },
      {
        "source": "/plataforma/granhermano.html",
        "destination": "/plataforma/administracion",
        "type": 301
      },
      {
        "source": "/",
        "destination": "/plataforma/inicio",
        "type": 302
      }
    ]
  }
}
